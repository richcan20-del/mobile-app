<!DOCTYPE html>

<html>

<head>

  <base target="_top">

  <meta charset="UTF-8">

<meta
 name="viewport"
 content="width=device-width, initial-scale=1, viewport-fit=cover">

<title>Customer Management</title>
<style>
  *{box-sizing:border-box}
  html,body{width:100%;min-height:100%;margin:0;padding:0;background:#f5f6f7;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:#222;-webkit-text-size-adjust:100%;text-size-adjust:100%}
  body{padding:16px}
  input,textarea,select,button{touch-action:manipulation!important;-webkit-text-size-adjust:100%;text-size-adjust:100%}
  @supports (-webkit-touch-callout:none){input,textarea,select{font-size:16px!important}}

  /* Layout Base */
  .container{width:100%;max-width:500px;margin:0 auto}
  .search-section,.sheet-section,.customer-card,.empty-state{background:#fff;border-radius:12px;padding:14px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,0,0,.06)}
  .form-row,.coupon-row,.button-row{display:flex;gap:10px;width:100%;align-items:flex-end}
  .form-half,.coupon-input-wrap,.button-row > *{flex:1;min-width:0}
  .form-group{margin-bottom:12px}

  /* Header & Buttons */
  .page-header{margin-bottom:16px}
  .subtitle{font-size:15px;color:#17365D}
  .top-back-button{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:4px!important;width:auto!important;min-width:44px!important;min-height:36px!important;margin-top:env(safe-area-inset-top,0)!important;margin-bottom:12px!important;padding:6px 12px!important;font-size:15px!important;font-weight:600!important;line-height:1!important;color:#007aff!important;background:#f2f2f7!important;border:1px solid #d1d1d6!important;border-radius:8px!important;cursor:pointer!important;user-select:none!important;-webkit-user-select:none!important;-webkit-tap-highlight-color:transparent!important;transition:background-color .15s,transform .1s!important}
  .top-back-button:active{background-color:#e5e5ea!important;transform:scale(.96)!important}

  /* Inputs & Selects */
  label,.search-label,.form-group label,.form-half label{display:block;margin-bottom:6px;font-size:14px;font-weight:600;color:#333}
  input,textarea,select{width:100%;border:1px solid #c9cdd2;border-radius:8px;background:#fff;font-size:16px!important;padding:10px 12px;outline:0}
  input:focus,textarea:focus,select:focus{border-color:#007aff}
  textarea{min-height:100px;resize:vertical}
  select{-webkit-appearance:none;-moz-appearance:none;appearance:none;height:48px;padding-right:36px;background:#fff url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="%23666666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>') no-repeat right 10px center/18px}


  /* Search */
  .search-wrapper{position:relative;width:100%}
  #customerSearch{padding-right:40px}
  .clear-search-button{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:28px;height:28px;border:0;border-radius:50%;background:#e5e5ea;color:#555;font-size:16px;cursor:pointer;display:none}
  .clear-search-button.show{display:block}

  /* Customer List & Card */
  .list-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
  .list-title{margin:0;font-size:18px;font-weight:700}
  .result-count{font-size:13px;color:#666}
  .customer-list{display:flex;flex-direction:column;gap:10px}
  .customer-card{cursor:pointer;transition:transform .1s,box-shadow .15s}
  .customer-card:active{transform:scale(.985);box-shadow:0 1px 3px rgba(0,0,0,.12)}
  .customer-card-header,.sheet-header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:8px}
  .customer-name{font-size:16px;font-weight:700;line-height:1.3}
  .customer-id,.sheet-customer-id{flex-shrink:0;font-size:11px;color:#999;background:#f2f2f7;padding:3px 6px;border-radius:6px}
  .customer-row{display:flex;align-items:flex-start;gap:6px;margin-top:5px;font-size:14px;line-height:1.4;color:#444}
  .customer-icon{width:18px;flex-shrink:0;text-align:center}
  .customer-value{word-break:break-word}
  .customer-empty{color:#999;font-style:italic}
  .empty-state{text-align:center;color:#666;font-size:14px;padding:24px 16px}

  /* Customer Sheet Views */
  #customerSheet{display:none}
  #customerSheet.show{display:block}
  #customerListView.hidden{display:none}
  .sheet-title{margin:0;font-size:18px;font-weight:700;line-height:1.25}

  /* Action Buttons */
  .update-customer-button{width:100%;min-height:48px;border:0;border-radius:10px;background:#222;color:#fff;font-size:16px;font-weight:600;cursor:pointer}
  .update-customer-button:active,.download-coupon-button:active{transform:scale(.98)}
  .update-customer-button:disabled{opacity:.55;cursor:default;transform:none}
  .sheet-back-button{width:100%;min-height:48px;border:1px solid #222;border-radius:10px;background:#fff;color:#222;font-size:15px;font-weight:600;cursor:pointer}
  
  /* Referral Coupon Row Fix */
  .coupon-row{display:flex;gap:10px;width:100%;align-items:flex-end}
  .coupon-row .coupon-input-wrap{flex:1;min-width:0}
  .coupon-row .download-coupon-button{flex:0 0 auto;width:auto;padding:0 16px;min-height:48px;border:0;border-radius:8px;background:#222;color:#fff;font-size:14px;font-weight:600;cursor:pointer;white-space:nowrap;height:48px}
  .button-row{margin-top:16px}

  /* Links & Toast */
  .customer-phone-link,.customer-address-link{color:inherit;text-decoration:none;cursor:pointer}
  .toast{position:fixed!important;bottom:calc(env(safe-area-inset-bottom,0) + 20px)!important;left:50%!important;width:90%!important;max-width:400px!important;padding:12px 16px!important;border-radius:8px!important;font-size:14px!important;font-weight:600!important;text-align:center!important;z-index:999999!important;opacity:0!important;visibility:hidden!important;transform:translateX(-50%) translateY(20px)!important;transition:opacity .25s,transform .25s,visibility .25s!important;box-shadow:0 4px 12px rgba(0,0,0,.2)!important;background:#323232!important;color:#fff!important;pointer-events:none!important}
  .toast.show{opacity:1!important;visibility:visible!important;transform:translateX(-50%) translateY(0)!important}
  .toast.success{background-color:#2e7d32!important}
  .toast.warning{background-color:#ed6c02!important}
  .toast.error{background-color:#d32f2f!important}

  @media (max-width:600px){body{padding:12px}.form-row{gap:8px}}
</style>

<body>
  <div id="toast" class="toast"></div>

  <div class="container">
    <div class="page-header">
      <button type="button" class="top-back-button" onclick="goBackToIndex()">← Back to Service Menu</button>
      <div class="subtitle">Customer Management</div>
    </div>

    <!-- LIST VIEW -->
    <div id="customerListView">
      <div class="search-section">
        <label class="search-label" for="customerSearch">Customer Search</label>
        <div class="search-wrapper">
          <input type="search" id="customerSearch" placeholder="Name, phone, email, WeChat or address" autocomplete="off">
          <button type="button" id="clearSearchButton" class="clear-search-button" onclick="clearCustomerSearch()">×</button>
        </div>
      </div>

      <div class="list-section">
        <div class="list-header">
          <h2 class="list-title">Customers</h2>
          <div id="resultCount" class="result-count"></div>
        </div>
        <div id="customerList" class="customer-list">
          <div class="empty-state">Search for a customer to begin.</div>
        </div>
      </div>
    </div>

    <!-- SHEET VIEW -->
    <div id="customerSheet">
      <button type="button" class="top-back-button" onclick="closeCustomerSheet()">← Back to Customers</button>

      <div class="sheet-section">
        <div class="sheet-header">
          <h2 id="sheetTitle" class="sheet-title">Customer</h2>
          <div id="sheetCustomerId" class="sheet-customer-id"></div>
        </div>

        <div class="form-row">
          <div class="form-half"><label for="sheetCustomerName">Customer Name</label><input type="text" id="sheetCustomerName" autocomplete="name"></div>
          <div class="form-half"><label for="sheetNickname">Nickname</label><input type="text" id="sheetNickname"></div>
        </div>

        <div class="form-row">
          <div class="form-half"><label for="sheetJobType">Job Type</label><select id="sheetJobType"></select></div>
          <div class="form-half"><label for="sheetCustomerType">Customer Type</label><select id="sheetCustomerType"></select></div>
        </div>

        <div class="form-row">
          <div class="form-half"><label for="sheetNotificationLanguage">Notification Language</label><select id="sheetNotificationLanguage"></select></div>
          <div class="form-half"><label for="sheetEmail">Email</label><input type="email" id="sheetEmail" autocomplete="email"></div>
        </div>

        <div class="form-row">
          <div class="form-half"><label for="sheetPhone">Phone</label><input type="tel" id="sheetPhone" autocomplete="tel"></div>
          <div class="form-half"><label for="sheetWechat">WeChat</label><input type="text" id="sheetWechat"></div>
        </div>

        <div class="form-group"><label for="sheetAddress">Address</label><input type="text" id="sheetAddress"></div>
        <div class="form-group"><label for="sheetNote">Note</label><textarea id="sheetNote"></textarea></div>
      </div>

      <div class="sheet-section">
        <div class="coupon-row">
          <div class="coupon-input-wrap">
            <label for="referralCoupon">Referral Coupon</label>
            <input type="text" id="referralCoupon" />
          </div>
          <button type="button" class="download-coupon-button" id="couponActionButton" onclick="handleCouponAction()">Generate Coupon</button>
        </div>
      </div>

      <div class="button-row">
        <button type="button" class="update-customer-button" id="updateCustomerButton" onclick="updateCustomer()">Update Customer</button>
        <button type="button" class="sheet-back-button" id="sheetBackBtn" onclick="closeCustomerSheet()">← Back to Customers</button>
      </div>
    </div>
  </div>


  <!-- =======================================================
       JAVASCRIPT
       ======================================================= -->

  <script>


    /* =======================================================
       GLABAL VARIABLES
       ======================================================= */

    let currentCustomer = null;

    let searchTimer = null;

    let updateCustomerRequestId = 0;

    let searchRequestId = 0;
    let downloadCouponRequestId = 0;
    


    /* =======================================================
       INITIALIZATION
       ======================================================= */

    
    document.addEventListener(
  'DOMContentLoaded',
  function() {

    const searchInput =
      document.getElementById(
        'customerSearch'
      );

       window.parent.postMessage({
    type: 'RICHCAN_GET_CONFIG'
  }, '*');

    if (searchInput) {

      searchInput.addEventListener(
        'input',
        function() {

          updateClearSearchButton();

          clearTimeout(
            searchTimer
          );

          const query =
            searchInput.value.trim();

          if (!query) {

            performCustomerSearch('');

            return;

          }

          searchTimer =
            setTimeout(
              function() {

                performCustomerSearch(
                  query
                );

              },
              250
            );

        }
      );

    }

    // Automatically load customer list
    performCustomerSearch('');

    if (searchInput) {
      searchInput.focus();
    }

  }
);


/* =======================================================
       SEARCH
======================================================= */
function performCustomerSearch(query = '') {
  renderEmptyState('Loading customers...');

  const requestId = ++searchRequestId;

  window.parent.postMessage({
    type: 'RICHCAN_SEARCH_CUSTOMERS',
    query: query,
    requestId: requestId
  }, '*');
}


/* =======================================================
       SEARCH RESULT
======================================================= */

    function handleCustomerSearchResult(
      customers
    ) {

      if (!Array.isArray(customers)) {

        renderEmptyState(
          'Unable to load customers.'
        );

        return;

      }


      document.getElementById(
        'resultCount'
      ).textContent =
        customers.length +
        (
          customers.length === 1
            ? ' customer'
            : ' customers'
        );


      if (!customers.length) {

        renderEmptyState(
          'No customers found.'
        );

        return;

      }


      const list =
        document.getElementById(
          'customerList'
        );


      list.innerHTML = '';


      customers.forEach(
        function(customer) {

          list.appendChild(
            createCustomerCard(
              customer
            )
          );

        }
      );

    }


    /* =======================================================
       CUSTOMER CARD
       ======================================================= */

    function createCustomerCard(
      customer
    ) {

      const card =
        document.createElement(
          'div'
        );


      card.className =
        'customer-card';


      card.addEventListener(
        'click',
        function() {

          openCustomerSheet(
            customer
          );

        }
      );


      const header =
        document.createElement(
          'div'
        );


      header.className =
        'customer-card-header';


      const name =
        document.createElement(
          'div'
        );


      name.className =
        'customer-name';


      name.textContent =
  (customer.customerName || 'Unnamed Customer') +
  (
    customer.nickname
      ? ' | ' + customer.nickname
      : ''
  );


      const id =
        document.createElement(
          'div'
        );


    id.textContent =
  (customer.customerId || '') +
  (
    customer.customerType
      ? ' | ' + customer.customerType
      : ''
  ) +
  (
    customer.jobType
      ? ' | ' + customer.jobType
      : ''
  );

      header.appendChild(name);
      header.appendChild(id);


      card.appendChild(header);


appendCustomerRow(
  card,
  '📍',
  customer.address,
  null,
  'address'
);


appendCustomerRow(
  card,
  '📞',
  (customer.phone || 'Not provided') +
  (
    customer.notificationLanguage
      ? ' | ' + customer.notificationLanguage
      : ''
  ),
  null,
  'phone'
);

appendCustomerRow(
  card,
  '✉️',
  customer.email
);
    

appendCustomerRow(
  card,
  '💳',
  '$' +
  Number(
    customer.availableCredit || 0
  ).toFixed(2) +
  ' Credit | Pending $' +
  Number(
    customer.pendingCredit || 0
  ).toFixed(2) +
  ' | ' +
  (customer.referralCode  || 'No Coupon')
);

appendCustomerRow(
  card,
  '🔧',
  (customer.totalVisits || 0) +
  ' Visits | Last: ' +
  (customer.lastServiceDate || 'No Service') +
  ' | ' +
  (customer.lastServiceTechnician || 'N/A')
);


      return card;

    }


    /* =======================================================
       CUSTOMER CARD ROW
       ======================================================= */
/* =======================================================
   CUSTOMER CARD ROW
   ======================================================= */

function appendCustomerRow(
  card,
  icon,
  value,
  onClick,
  type
) {

  const row =
    document.createElement(
      'div'
    );


  row.className =
    'customer-row';


  const iconElement =
    document.createElement(
      'div'
    );


  iconElement.className =
    'customer-icon';


  iconElement.textContent =
    icon;


  /*
   * ===================================================
   * PHONE
   * ===================================================
   */

  if (
    type === 'phone' &&
    value
  ) {

    const phoneLink =
      document.createElement(
        'a'
      );


    phoneLink.href =
      'tel:' +
      value;


    phoneLink.textContent =
      value;


    phoneLink.className =
      'customer-value customer-phone-link';


    phoneLink.addEventListener(
      'click',
      function(event) {

        event.stopPropagation();

      }
    );


    row.appendChild(
      iconElement
    );

    row.appendChild(
      phoneLink
    );

    card.appendChild(
      row
    );

    return;

  }


  /*
   * ===================================================
   * ADDRESS
   * ===================================================
   */

  if (
    type === 'address' &&
    value
  ) {

    const addressLink =
      document.createElement(
        'a'
      );


    addressLink.href =
      '#';


    addressLink.textContent =
      value;


    addressLink.className =
      'customer-value customer-address-link';


    addressLink.addEventListener(
      'click',
      function(event) {

        event.preventDefault();

        event.stopPropagation();


        const confirmed =
          window.confirm(
            'Open Google Maps?'
          );


        if (
          confirmed
        ) {

          window.open(
            'https://www.google.com/maps/search/?api=1&query=' +
            encodeURIComponent(
              value
            ),
            '_blank'
          );

        }

      }
    );


    row.appendChild(
      iconElement
    );

    row.appendChild(
      addressLink
    );

    card.appendChild(
      row
    );

    return;

  }


  /*
   * ===================================================
   * NORMAL VALUE
   * ===================================================
   */

  const valueElement =
    document.createElement(
      'div'
    );


  valueElement.className =
    'customer-value';


  if (value) {

    valueElement.textContent =
      value;

  } else {

    valueElement.textContent =
      'Not provided';

    valueElement.classList.add(
      'customer-empty'
    );

  }


  /*
   * ===================================================
   * CLICKABLE ROW
   * ===================================================
   */

  if (
    typeof onClick ===
    'function'
  ) {

    row.style.cursor =
      'pointer';


    row.addEventListener(
      'click',
      function(event) {

        event.stopPropagation();

        onClick(event);

      }
    );

  }


  row.appendChild(
    iconElement
  );

  row.appendChild(
    valueElement
  );


  card.appendChild(
    row
  );

}



    /* =======================================================
       EMPTY STATE
       ======================================================= */

    function renderEmptyState(
      message
    ) {

      const list =
        document.getElementById(
          'customerList'
        );


      list.innerHTML =
        '<div class="empty-state">' +
        message +
        '</div>';


      document.getElementById(
        'resultCount'
      ).textContent = '';

    }


/* =======================================================
       OPEN CUSTOMER SHEET
======================================================= */

function openCustomerSheet(
      customer
    ) {

      currentCustomer =
        Object.assign(
          {},
          customer
        );


document.getElementById('sheetCustomerName').value =
  customer.customerName || '';

document.getElementById('sheetNickname').value =
  customer.nickname || '';

document.getElementById('sheetJobType').value =
  customer.jobType || '';

document.getElementById('sheetCustomerType').value =
  customer.customerType || '';

document.getElementById('sheetNotificationLanguage').value =
  customer.notificationLanguage || '';

document.getElementById('sheetAddress').value =
  customer.address || '';

document.getElementById('sheetPhone').value =
  customer.phone || '';

document.getElementById('sheetWechat').value =
  customer.wechat || '';

document.getElementById('sheetEmail').value =
  customer.email || '';

document.getElementById('sheetNote').value =
  customer.note || '';     

const couponInfo =
  document.getElementById('referralCoupon');

const couponButton =
  document.getElementById('couponActionButton');

if (couponInfo) {
  couponInfo.value =
    customer.referralCode || '';
}

if (couponButton) {
  couponButton.textContent =
    customer.referralCode
      ? 'Download Coupon'
      : 'Generate Coupon';

  couponButton.style.display = 'block';
}




      document.getElementById(
        'customerListView'
      ).classList.add(
        'hidden'
      );


      document.getElementById(
        'customerSheet'
      ).classList.add(
        'show'
      );


      window.scrollTo(
        0,
        0
      );

    }


    /* =======================================================
       CLOSE CUSTOMER SHEET
       ======================================================= */

    function closeCustomerSheet() {

      currentCustomer =
        null;


      document.getElementById(
        'customerSheet'
      ).classList.remove(
        'show'
      );


      document.getElementById(
        'customerListView'
      ).classList.remove(
        'hidden'
      );


      window.scrollTo(
        0,
        0
      );

    }


/***************************************************
 * UPDATE CUSTOMER
 ***************************************************/
function updateCustomer() {
  if (!currentCustomer) {
    showToast('No customer selected.', 'error', 4000);
    return;
  }

  const customerId = currentCustomer.customerId;
  const customerName = document.getElementById('sheetCustomerName').value.trim();
  const nickname = document.getElementById('sheetNickname').value.trim();
  const address = document.getElementById('sheetAddress').value.trim();
  const phone = document.getElementById('sheetPhone').value.trim();
  const email = document.getElementById('sheetEmail').value.trim();
  const wechat = document.getElementById('sheetWechat').value.trim();
  const note = document.getElementById('sheetNote').value.trim();
  const jobType = document.getElementById('sheetJobType').value;
  const customerType = document.getElementById('sheetCustomerType').value;
  const notificationLanguage = document.getElementById('sheetNotificationLanguage').value;

  /***************************************************
   * VALIDATION
   ***************************************************/
  if (!customerName) {
    showToast('Customer Name is required.', 'error', 4000);
    document.getElementById('sheetCustomerName').focus();
    return;
  }

  if (!customerId) {
    showToast('Customer ID is missing.', 'error', 4000);
    return;
  }

  if (!address) {
    showToast('Address is missing.', 'error', 4000);
    document.getElementById('sheetAddress').focus();
    return;
  }

  if (!phone && !email && !wechat) {
    showToast('Please enter a phone number, email, or WeChat.', 'error', 4000);
    document.getElementById('sheetPhone').focus();
    return;
  }

  /***************************************************
   * UPDATE DATA
   ***************************************************/
  const data = {
    customerId: customerId,
    customerName: customerName,
    nickname: nickname,
    address: address,
    phone: phone,
    email: email,
    wechat: wechat,
    note: note,
    jobType: jobType,
    customerType: customerType,
    notificationLanguage: notificationLanguage,
    referralCode: document.getElementById('referralCoupon').value.trim()
  };

  const requestId = ++updateCustomerRequestId;

  const button = document.getElementById('updateCustomerButton');

  if (button) {
    button.disabled = true;
    button.textContent = 'Updating Customer...';
  }

  showToast('Updating customer...', 'success', 1500);

  window.parent.postMessage({
    type: 'RICHCAN_UPDATE_CUSTOMER',
    data: data,
    requestId: requestId
  }, '*');
}


/* =======================================================
       CLEAR SEARCH
======================================================= */

    function clearCustomerSearch() {

      const input =
        document.getElementById(
          'customerSearch'
        );


      input.value = '';


      updateClearSearchButton();


      renderEmptyState(
        'Search for a customer to begin.'
      );


      input.focus();

    }


    function updateClearSearchButton() {

      const input =
        document.getElementById(
          'customerSearch'
        );


      const button =
        document.getElementById(
          'clearSearchButton'
        );


      if (
        input &&
        button
      ) {

        button.classList.toggle(
          'show',
          Boolean(
            input.value
          )
        );

      }

    }


    /* =======================================================
       TOAST
       ======================================================= */

    let toastTimer = null;


    function showToast(
      message,
      type = 'success',
      duration = 3000
    ) {

      const toast =
        document.getElementById(
          'toast'
        );


      if (!toast) {
        return;
      }


      if (toastTimer) {

        clearTimeout(
          toastTimer
        );

      }


      toast.className =
        'toast';


      toast.textContent =
        message;


      toast.classList.add(
        type
      );


      requestAnimationFrame(
        function() {

          toast.classList.add(
            'show'
          );

        }
      );


      toastTimer =
        setTimeout(
          function() {

            toast.classList.remove(
              'show'
            );

          },
          duration
        );

    }


    /* =======================================================
       NAVIGATION
       ======================================================= */

    function goBackToIndex() {

      window.parent.postMessage(
        {
          type:
            'RICHCAN_NAVIGATE',

          page:
            'index'

        },
        '*'
      );

    }


    /* =======================================================
       MESSAGE LISTENER
       ======================================================= */

window.addEventListener(
      'message',
      function(event) {

        if (
          !event.data
        ) {
          return;
        }


/* ===================================================
          RICHCAN_GENERATE_CUSTOMER_COUPON_RESULT
=================================================== */
if (event.data &&
    event.data.type === 'RICHCAN_GENERATE_CUSTOMER_COUPON_RESULT') {

  handleGenerateCouponResult(
    event.data.result
  );

  return;
}

/* ===================================================
           SEARCH RESULT
=================================================== */

if (event.data.type === 'RICHCAN_SEARCH_CUSTOMERS_RESULT') {

  console.log('Customer search result received:', event.data);

  if (event.data.requestId !== searchRequestId) {
    return;
  }

  handleCustomerSearchResult(event.data.customers || []);

  return;
}




        /* ===================================================
           UPDATE RESULT
           =================================================== */

        if (
          event.data.type ===
          'RICHCAN_UPDATE_CUSTOMER_RESULT'
        ) {

          handleUpdateCustomerResult(
            event.data.result,
            event.data.error
          );

          return;

        }


  /***************************************************
 * CONFIG RESULT
 ***************************************************/
if (event.data.type === 'RICHCAN_CONFIG_RESULT') {
  buildCustomerConfigOptions(event.data.config);
  return;
}

/* ===================================================
   DOWNLOAD COUPON RESULT
   =================================================== */

if (
  event.data.type ===
  'RICHCAN_DOWNLOAD_CUSTOMER_COUPON_RESULT'
) {

  handleDownloadCouponResult(
    event.data.result,
    event.data.error
  );

  return;
}

      }
    );


/***************************************************
 * UPDATE RESULT
 ***************************************************/
function handleUpdateCustomerResult(result, error) {
  const button = document.getElementById('updateCustomerButton');

  if (button) {
    button.disabled = false;
    button.textContent = 'Update Customer';
  }

  if (!result || result.success !== true) {
    showToast(
      error ||
      (result && result.message) ||
      'Unable to update customer.',
      'error',
      5000
    );

    return;
  }

  /***************************************************
   * UPDATE LOCAL CUSTOMER
   ***************************************************/
  currentCustomer.customerName = document.getElementById('sheetCustomerName').value.trim();
  currentCustomer.nickname = document.getElementById('sheetNickname').value.trim();
  currentCustomer.address = document.getElementById('sheetAddress').value.trim();
  currentCustomer.phone = document.getElementById('sheetPhone').value.trim();
  currentCustomer.email = document.getElementById('sheetEmail').value.trim();
  currentCustomer.wechat = document.getElementById('sheetWechat').value.trim();
  currentCustomer.note = document.getElementById('sheetNote').value.trim();
  currentCustomer.jobType = document.getElementById('sheetJobType').value;
  currentCustomer.customerType = document.getElementById('sheetCustomerType').value;
  currentCustomer.notificationLanguage = document.getElementById('sheetNotificationLanguage').value;
  currentCustomer.referralCode = document.getElementById('referralCoupon').value.trim();

  document.getElementById('sheetTitle').textContent =
    currentCustomer.customerName;

  showToast(
    'Customer updated successfully.',
    'success',
    3000
  );

  setTimeout(function() {
    closeCustomerSheet();
  }, 1200);
}



/*************************************************
 * BUILD CUSTOMER CONFIG OPTIONS
 *************************************************/
function buildCustomerConfigOptions(config) {
  const jobTypeSelect = document.getElementById('sheetJobType');
  const customerTypeSelect = document.getElementById('sheetCustomerType');
  const languageSelect = document.getElementById('sheetNotificationLanguage');

  if (!jobTypeSelect || !customerTypeSelect || !languageSelect) return;

  jobTypeSelect.innerHTML = '';
  customerTypeSelect.innerHTML = '';
  languageSelect.innerHTML = '';

  /*************************************************
   * JOB TYPE
   *
   * Display = value
   * Save = shortName
   *************************************************/
  (config.jobTypes || []).forEach(function(item) {
    if (!item || item.active !== true) return;

    const option = document.createElement('option');

    option.value = item.shortName;
    option.textContent = item.value;

    jobTypeSelect.appendChild(option);
  });

  /*************************************************
   * CUSTOMER TYPE
   *************************************************/
  (config.customerTypes || []).forEach(function(type) {
    const option = document.createElement('option');

    option.value = type;
    option.textContent = type;

    customerTypeSelect.appendChild(option);
  });

  /*************************************************
   * NOTIFICATION LANGUAGE
   *
   * Display = label
   * Save = value
   *************************************************/
  const languageOrder = [
  'zh-CN',
  'zh-TW',
  'en'
];

languageOrder.forEach(function(value) {
  const languages = config.notificationLanguages || {};
  const item = Object.values(languages).find(function(item) {
    return item && item.value === value;
  });

  if (!item) return;

  const option = document.createElement('option');

  option.value = item.value;
  option.textContent = item.label;

  languageSelect.appendChild(option);
});


}

/*************************************************
 * Download Customer Coupon
 *************************************************/
function downloadCoupon() {
  if (!currentCustomer) {
    showToast('No customer selected.', 'error', 4000);
    return;
  }

  const couponId = String(currentCustomer.couponId || '').trim();

  if (!couponId) {
    showToast('This customer does not have a coupon.', 'error', 4000);
    return;
  }

  const button = document.getElementById('couponActionButton');

  if (button) {
    button.disabled = true;
    button.textContent = 'Preparing Coupon...';
  }

  showToast('Preparing coupon...', 'success', 2000);

  const requestId = ++downloadCouponRequestId;

  window.parent.postMessage({
    type: 'RICHCAN_DOWNLOAD_CUSTOMER_COUPON',
    data: { couponId: couponId },
    requestId: requestId
  }, '*');
}



/*************************************************
 * Handle Download Coupon Result
 *************************************************/
async function handleDownloadCouponResult(result, error) {
  const button = document.getElementById('couponActionButton');

  if (button) {
    button.disabled = false;
    button.textContent = 'Download Coupon';
  }

  if (!result || result.success !== true) {
    showToast(
      error || (result && result.message) || 'Unable to download coupon.',
      'error',
      5000
    );
    return;
  }

  if (!result.dataUrl) {
    showToast('Coupon image data is missing.', 'error', 5000);
    return;
  }

  try {
    const response = await fetch(result.dataUrl);
    const blob = await response.blob();

    const fileName =
      result.fileName || 'coupon.png';

    const url =
      URL.createObjectURL(blob);

    const link =
      document.createElement('a');

    link.href = url;
    link.download = fileName;

    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);

    setTimeout(function() {
      URL.revokeObjectURL(url);
    }, 1000);

    showToast(
      'Coupon downloaded successfully.',
      'success',
      3000
    );

  } catch (error) {
    console.error(
      'Download coupon failed:',
      error
    );

    showToast(
      'Unable to download coupon.',
      'error',
      5000
    );
  }
}






function handleCouponAction() {
  if (!currentCustomer) {
    showToast('No customer selected.', 'error', 4000);
    return;
  }

  if (String(currentCustomer.referralCode || '').trim()) {
    downloadCoupon();
  } else {
    generateCoupon();
  }
}


function generateCoupon() {
  if (!currentCustomer) {
    showToast('No customer selected.', 'error', 4000);
    return;
  }

  const customerId =
    String(currentCustomer.customerId || '').trim();

  if (!customerId) {
    showToast('Customer ID is required.', 'error', 4000);
    return;
  }

  const button =
    document.getElementById('couponActionButton');

  if (button) {
    button.disabled = true;
    button.textContent = 'Generating...';
  }

  window.parent.postMessage({
    type: 'RICHCAN_GENERATE_CUSTOMER_COUPON',
    data: {
      customerId: customerId
    }
  }, '*');
}


function handleGenerateCouponResult(result) {
  const button =
    document.getElementById('couponActionButton');

  if (!result || !result.success) {
    if (button) {
      button.disabled = false;
      button.textContent = 'Generate Coupon';
    }

    showToast(
      result && result.message
        ? result.message
        : 'Failed to generate coupon.',
      'error',
      5000
    );

    return;
  }

  currentCustomer.referralCode =
    result.referralCode || '';

  currentCustomer.couponId =
    result.couponId || '';

  const referralInput =
    document.getElementById('referralCoupon');

  if (referralInput) {
    referralInput.value =
      result.referralCode || '';
  }

  if (button) {
    button.disabled = false;
    button.textContent = 'Download Coupon';
  }

  showToast(
    'Coupon generated successfully.',
    'success',
    4000
  );
}
